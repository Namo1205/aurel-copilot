# Desk sign-in. The password everyone types on the sign-in page (defaults to "aurel" for
# local development) and the secret that signs the session cookie the API routes check.
# Set both on any public deployment: openssl rand -base64 32
DESK_PASSWORD=
DESK_SECRET=

# Optional. When set, the desk uses Google Gemini; when absent, the deterministic rules engine.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash. Pro models need billing enabled on the Google AI Studio project.
GEMINI_MODEL=
# Optional. Fallback chain, tried in order when a model is over quota or unavailable.
# Defaults to GEMINI_MODEL,gemini-3-flash-preview,gemini-3.5-flash-lite. The rules engine is the last resort.
GEMINI_MODELS=
# Optional. Set to "rules" to force the rules engine even if a key is present.
COPILOT_MODE=
# Optional. Hours after which a price quote with no reply gets a prepared follow-up for its
# owner (default 48). Set to 0.02 to rehearse the follow-up within a minute.
NEXT_PUBLIC_QUOTE_FOLLOW_UP_HOURS=

# Live Gmail link (optional, for the demo). See README "Live Gmail".
# OAuth "Desktop app" client from Google Cloud, Gmail API enabled.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Written by: npx tsx --env-file=.env.local scripts/gmail-auth.ts
GMAIL_REFRESH_TOKEN=
# Set to "off" to read mail but never send.
GMAIL_SEND=
# Scheduled check (optional). When set, GET /api/cron/poll with "Authorization: Bearer <value>"
# answers policy questions and sends the fixed templates with no desk tab open.
# Called every 5 minutes by .github/workflows/poll-mailbox.yml. openssl rand -base64 32
CRON_SECRET=
